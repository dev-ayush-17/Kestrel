# Kestrel Stays Backend Environment Template
PROJECT_NAME="Kestrel Stays API"
API_V1_STR="/api/v1"

# Security & JWT Tokens
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Connection String (using asyncpg driver)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/Kestrel_Stays"

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_ECHO=false

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Default Avatar & Static Media
DEFAULT_AVATAR_URL="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80"

